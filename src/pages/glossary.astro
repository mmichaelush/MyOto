---
import Site from '../layouts/Site.astro';
import '../styles/catalog.css';

const terms = [
  [
    'שנת ייצור',
    'השנה הרשומה לייצור הרכב. רישום ראשון עשוי להתבצע בשנה מאוחרת יותר.',
  ],
  [
    'עלייה לכביש',
    'מועד הרישום הראשון כפי שהוא מופיע במאגר הרישוי. המקור עשוי למסור חודש ושנה בלבד.',
  ],
  [
    'טסט אחרון',
    'מועד מבחן הרישוי האחרון שדווח במרשם. תוקף הרישוי מופיע בשדה נפרד.',
  ],
  [
    'תוקף רישוי',
    'תאריך סיום התוקף שמופיע במרשם. רכב עשוי להופיע במרשם הפעיל גם אחרי שתאריך זה עבר.',
  ],
  [
    'ירידה מהכביש',
    'רישום של ביטול סופי במאגר משרד התחבורה. עילת הביטול תלויה בפרטים שנמסרו במקור.',
  ],
  [
    'קוד דגם',
    'מזהה של דגם במאגר משרד התחבורה. MyOto מצרף אליו קוד תוצר, סוג דגם ושנת ייצור כדי להתאים מפרט.',
  ],
  ['קוד מנוע', 'מזהה לדגם מנוע. אותו קוד יכול להופיע בכלי רכב רבים.'],
  [
    'מספר מנוע',
    'מספר סידורי המזהה את המנוע שנרשם לרכב. שינוי במספר בין צילומי מצב מצביע על שינוי ברישום.',
  ],
  [
    'ידיים רשומות',
    'מספר רישומי הבעלות בדוח לאחר ניכוי תקופות שבהן סוג הבעלות היה סוחר.',
  ],
  [
    'הפרש נסועה',
    'קריאת מד המרחק המאוחרת פחות הקריאה הקודמת. ירידה דורשת בירור מול היסטוריית המדידות והרכב.',
  ],
  [
    'קבוצת אגרת רישוי',
    'סיווג שמשמש לקביעת אגרת הבסיס ברכב פרטי ומסחרי קל, לצד שנת העלייה לכביש.',
  ],
  [
    'ריקול',
    'קריאת שירות לתיקון ליקוי בטיחות. הודעה ברמת הדגם ורישום לרכב מסוים נבדקים במקורות שונים.',
  ],
];
---

<Site title="מילון מונחים לרכב">
  <section class="panel catalog-heading">
    <h1>מילון מונחים לרכב</h1>
    <a href={import.meta.env.BASE_URL + 'buying-guide/'}>
      בדיקות לפני קניית רכב
    </a>
  </section>
  <section class="panel catalog-data" aria-label="מונחים בדוח ובקטלוג">
    <dl class="grid-data">
      {terms.map(([term, definition]) => (
        <div class="datum">
          <dt>
            <strong>{term}</strong>
          </dt>
          <dd>{definition}</dd>
        </div>
      ))}
    </dl>
  </section>
</Site>
