---
import Site from '../layouts/Site.astro';
---

<Site title="השוואת רכבים" privatePage={true}>
  <section class="panel">
    <h1>השוואת רכבים</h1>
    <p>הזינו שני מספרי רישוי כדי להשוות את הנתונים שנמצאו.</p>
    <form class="search" id="compare">
      <label class="control">
        רכב ראשון
        <input
          class="text-input"
          name="a"
          inputmode="numeric"
          maxlength="18"
          dir="ltr"
          required
        />
      </label>
      <label class="control">
        רכב שני
        <input
          class="text-input"
          name="b"
          inputmode="numeric"
          maxlength="18"
          dir="ltr"
          required
        />
      </label>
      <button>השוואה</button>
    </form>
  </section>
  <p role="status" id="comparison-status"></p>
  <section id="comparison" class="panel table-scroll" hidden></section>
</Site>
<script>
  import '../ui/compare';
</script>
