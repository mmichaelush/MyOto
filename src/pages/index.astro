---
import Site from '../layouts/Site.astro';
import '../styles/vehicle.css';
---

<Site title="בדיקת רכב לפי מספר רישוי" privatePage={true}>
  <section class="panel hero lookup-hero">
    <div class="hero-heading">
      <h1>בדיקת רכב לפי מספר רישוי</h1>
      <p>מפרט רכב, רישוי, בעלויות וקריאות שירות.</p>
    </div>
    <form id="vehicle-form" class="search">
      <div class="control">
        <label for="plate">מספר רישוי או צמ״ה</label>
        <div class="plate plate-input" dir="ltr">
          <span class="plate-country" aria-hidden="true">
            IL
          </span>
          <input
            id="plate"
            name="search"
            inputmode="numeric"
            autocomplete="off"
            placeholder="12-345-67"
            maxlength="18"
            aria-describedby="plate-help"
            required
          />
        </div>
      </div>
      <button type="submit" class="lookup-submit">
        <svg
          viewBox="0 0 24 24"
          width="19"
          height="19"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        חיפוש רכב
      </button>
      <small id="plate-help">4–8 ספרות, עם מקפים או בלי.</small>
    </form>
    <noscript>כדי לבדוק רכב, יש להפעיל JavaScript בדפדפן.</noscript>
  </section>
  <p id="search-status" role="status" class="muted"></p>
  <div id="actions" class="actions" role="group" aria-label="פעולות דוח"></div>
  <div id="report"></div>
  <aside id="saved" class="panel" hidden></aside>
</Site>
<script>
  import '../ui/search';
</script>
