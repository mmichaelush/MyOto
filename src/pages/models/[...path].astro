---
import Site from '../../layouts/Site.astro';
import CatalogSource from '../../components/CatalogSource.astro';
import Cohort from '../../components/Cohort.astro';
import MakeModels from '../../components/MakeModels.astro';
import '../../styles/catalog.css';
import {
  catalog,
  count,
  totals,
  totalsByYear,
  rankedModels,
  years,
  type Make,
  type Model,
} from '../../data/catalog';
type Props = { make: Make; model?: Model; year?: number };
export function getStaticPaths() {
  return catalog.makes.flatMap((make) => [
    { params: { path: make.id }, props: { make } as Props },
    ...make.models.flatMap((model) => [
      {
        params: { path: `${make.id}/${model.id}` },
        props: { make, model } as Props,
      },
      ...years(model).map((year) => ({
        params: { path: `${make.id}/${model.id}/${year}` },
        props: { make, model, year } as Props,
      })),
    ]),
  ]);
}
const { make, model, year } = Astro.props;
const base = import.meta.env.BASE_URL + 'models/';
const makeUrl = `${base}${make.id}/`;
const modelUrl = model ? makeUrl + model.id + '/' : '';
const all = model?.records ?? make.models.flatMap((entry) => entry.records);
const rows = year ? all.filter((row) => row.year === year) : all;
const sum = totals(rows);
const title = [make.name, model?.name, year].filter(Boolean).join(' ');
const yearRows = totalsByYear(all);
const peak = Math.max(1, ...yearRows.map((row) => row.active));
const position = yearRows.findIndex((row) => row.year === year);
const newer = yearRows[position - 1]?.year;
const older = yearRows[position + 1]?.year;
const topYear = yearRows.reduce(
  (best, row) => (!best || row.active > best.active ? row : best),
  yearRows[0],
);
const ranked = model && !year ? rankedModels(make) : [];
const fuels = [
  ...new Set(
    rows.flatMap((row) =>
      row.variants.flatMap(([, fuel]) => (fuel ? [fuel] : [])),
    ),
  ),
];
const displacements = [
  ...new Set(
    rows.flatMap((row) => row.variants.flatMap(([, , cc]) => (cc ? [cc] : []))),
  ),
].sort((a, b) => a - b);
---

<Site title={title}>
  <nav aria-label="מיקום בקטלוג" class="breadcrumbs">
    <a href={base}>יצרנים ודגמים</a>
    {model && <a href={makeUrl}>{make.name}</a>}
    {year && model && (
      <a href={modelUrl}>
        <bdi>{model.name}</bdi>
      </a>
    )}
  </nav>
  <section class="panel catalog-heading">
    <h1>
      {make.name}
      {model && (
        <>
          {' '}
          <bdi>{model.name}</bdi>
        </>
      )}
      {year && ` ${year}`}
    </h1>
    <dl class="catalog-stats">
      <div>
        <dt>כלי רכב פעילים</dt>
        <dd>{count.format(sum.active)}</dd>
      </div>
      <div>
        <dt>כלי רכב לא פעילים</dt>
        <dd>{count.format(sum.inactive)}</dd>
      </div>
      {year ? (
        <div>
          <dt>קודי דגם בשנה זו</dt>
          <dd>{count.format(rows.length)}</dd>
        </div>
      ) : (
        <div>
          <dt>שנת ייצור עם הכי הרבה רכבים פעילים</dt>
          <dd>{topYear?.active ? topYear.year : '—'}</dd>
        </div>
      )}
    </dl>
    {year && (fuels.length > 0 || displacements.length > 0) && (
      <dl class="catalog-variant-summary">
        {fuels.length > 0 && (
          <div>
            <dt>דלק בגרסאות שבקטלוג</dt>
            <dd>{fuels.join(' · ')}</dd>
          </div>
        )}
        {displacements.length > 0 && (
          <div>
            <dt>נפחי מנוע בגרסאות</dt>
            <dd>
              {displacements.map((cc) => count.format(cc)).join(' · ')} סמ״ק
            </dd>
          </div>
        )}
      </dl>
    )}
    {year && (
      <nav class="catalog-year-links" aria-label="שנתונים של הדגם">
        {newer && <a href={modelUrl + newer + '/'}>שנתון {newer}</a>}
        {older && <a href={modelUrl + older + '/'}>שנתון {older}</a>}
        <a href={modelUrl}>כל השנתונים</a>
      </nav>
    )}
  </section>
  {!model && <MakeModels {make} {makeUrl} />}
  {!year && (
    <section class="panel catalog-data">
      <h2>כלי רכב לפי שנת ייצור</h2>
      <div
        class="table-scroll"
        role="region"
        aria-label="כלי רכב לפי שנת ייצור"
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">שנת ייצור</th>
              <th scope="col">פעילים</th>
              <th scope="col">לא פעילים</th>
            </tr>
          </thead>
          <tbody>
            {yearRows.map((row) => (
              <tr>
                <th scope="row">
                  {model ? (
                    <a href={`${modelUrl}${row.year}/`}>{row.year}</a>
                  ) : (
                    row.year
                  )}
                </th>
                <td>
                  {count.format(row.active)}
                  <meter
                    aria-label={`פעילים בשנת ${row.year}`}
                    min="0"
                    max={peak}
                    value={row.active}
                  ></meter>
                </td>
                <td>{count.format(row.inactive)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  {year && (
    <section class="panel catalog-data">
      <h2>גרסאות וקודי דגם</h2>
      <div
        class="table-scroll"
        role="region"
        aria-label="גרסאות וקודי דגם"
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">קוד</th>
              <th scope="col">דגם רישוי</th>
              <th scope="col">מפרטי קטלוג</th>
              <th scope="col">פעילים</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">
                  {row.code} <bdi>{row.type}</bdi>
                </th>
                <td>
                  <bdi>{row.name}</bdi>
                </td>
                <td>
                  {row.variants.length ? (
                    <ul>
                      {row.variants.map(([trim, fuel, cc, automatic]) => (
                        <li>
                          <bdi>{trim ?? 'גימור לא ידוע'}</bdi> ·{' '}
                          {fuel ?? 'דלק לא ידוע'}
                          {cc ? ` · ${cc} סמ״ק` : ''}
                          {Number(automatic) === 1 ? ' · גיר אוטומטי' : ''}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    'מפרט לא זמין'
                  )}
                </td>
                <td>{count.format(row.active)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  {model && year && (
    <section class="panel catalog-data">
      <h2>שנתונים סמוכים</h2>
      <div
        class="table-scroll"
        role="region"
        aria-label="שנתונים סמוכים"
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">שנת ייצור</th>
              <th scope="col">פעילים</th>
              <th scope="col">לא פעילים</th>
            </tr>
          </thead>
          <tbody>
            {yearRows
              .filter((row) => Math.abs(year - row.year) <= 2)
              .map((row) => (
                <tr class:list={[{ different: year === row.year }]}>
                  <th scope="row">
                    <a href={`${modelUrl}${row.year}/`}>{row.year}</a>
                  </th>
                  <td>{count.format(row.active)}</td>
                  <td>{count.format(row.inactive)}</td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  {model && year && <Cohort id={`${make.id}/${model.id}/${year}`} />}
  {model && !year && make.models.length > 1 && (
    <section class="panel catalog-directory">
      <h2>דגמים נוספים של {make.name}</h2>
      <div class="model-grid">
        {ranked
          .filter((item) => item.id !== model.id)
          .slice(0, 6)
          .map((item) => (
            <a class="model-card" href={makeUrl + item.id + '/'}>
              <bdi>{item.name}</bdi>
            </a>
          ))}
      </div>
      <a href={makeUrl}>כל דגמי {make.name}</a>
    </section>
  )}
  <CatalogSource />
</Site>
