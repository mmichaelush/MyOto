---
import '../styles/site.css';
const {
  title,
  description = 'מידע על כלי רכב בישראל ממקורות ממשלתיים',
  privatePage = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    {privatePage && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href={base + 'favicon.ico'} />
    <title>{title} | MyOto</title>
  </head>
  <body>
    <a class="skip" href="#main">
      דילוג לתוכן
    </a>
    <header class="site-header">
      <nav class="wrap" aria-label="ניווט ראשי">
        <a class="brand" href={base} dir="ltr">
          <span class="brand-mark" aria-hidden="true"></span>MyOto
        </a>
        <a
          href={base}
          aria-current={Astro.url.pathname === base ? 'page' : undefined}
        >
          בדיקת רכב
        </a>
        <a href={base + 'models/'}>יצרנים ודגמים</a>
      </nav>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="wrap footer">
      <a href="https://github.com/mmichaelush/MyOto">MyOto</a>
      <a href={base + 'privacy/'}>פרטיות ומקורות</a>
    </footer>
  </body>
</html>
