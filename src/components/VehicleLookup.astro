---
interface Props {
  embedded?: boolean;
}
const { embedded = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="panel hero lookup-hero">
  <div class="hero-heading">
    <svg
      class="lookup-mark"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.65"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <circle cx="11.5" cy="14.5" r="2.5"></circle>
      <path d="M13.25 16.25 15 18"></path>
    </svg>
    <div>
      <h1>בדיקת רכב לפי מספר רישוי</h1>
      <p>מפרט רכב, רישוי, בעלויות וקריאות שירות.</p>
    </div>
  </div>
  <form
    id="vehicle-form"
    class="search"
    action={embedded ? base + 'embed/' : base}
    method="get"
  >
    <div class="control">
      <label for="plate">מספר רישוי או צמ״ה</label>
      <div class="plate plate-input" dir="ltr">
        <span class="plate-country" aria-hidden="true">
          IL
        </span>
        <input
          id="plate"
          name="search"
          inputmode="numeric"
          autocomplete="off"
          placeholder="12-345-67"
          maxlength="18"
          aria-describedby="plate-help"
          required
        />
      </div>
    </div>
    <button type="submit" class="lookup-submit">
      <svg
        viewBox="0 0 24 24"
        width="19"
        height="19"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      חיפוש רכב
    </button>
    <small id="plate-help">
      <bdi>4–8</bdi> ספרות, עם מקפים או בלי.
    </small>
  </form>
  <noscript>כדי לבצע את הבדיקה, יש להפעיל JavaScript בדפדפן.</noscript>
</section>
<div class="lookup-status">
  <p id="search-status" role="status" class="muted"></p>
</div>
<div id="actions" class="actions" role="group" aria-label="פעולות דוח"></div>
<div id="report"></div>
<aside id="saved" class="panel" hidden></aside>
<script>
  import '../ui/search';
</script>
