---
import { cohorts, fetchedAt } from '../data/cohorts';
import { count } from '../data/catalog';
import { resources } from '../data/sources';
const { id } = Astro.props;
const stat = cohorts[id];
const distributions = stat
  ? ([
      ['צבע', stat.colors],
      ['בעלות רשומה', stat.ownership],
      ['דלק', stat.fuel],
      ['רמת גימור', stat.trims],
    ] as const)
  : [];
---

{stat && (
  <section class="panel">
    <h2>מדגם רכבים פעילים מהשנתון</h2>
    <p class="muted">
      {stat.frameSize
        ? `מדגם שיטתי של ${stat.n} כלי רכב תואמים מתוך ${count.format(stat.frameSize)} שורות במרשם הפעיל. הדגימה נפרסת על פני שמונה מקטעי רישוי ואינה אקראית.`
        : `מדגם נוחות של ${stat.n} כלי רכב תואמים מתחילת המאגר.`}
      נשלף ב־{(stat.fetchedAt ?? fetchedAt).slice(0, 10)}.
    </p>
    <div class="grid-data">
      {distributions.map(([label, values]) => (
        <section class="datum">
          <h3>{label}</h3>
          <ul class="distributions">
            {values.map(([name, n]) => (
              <li>
                {name} · {n}
                <meter
                  aria-label={`${name} מתוך ${stat.n}`}
                  min="0"
                  max={stat.n}
                  value={n}
                ></meter>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <h3>נסועה בטסט האחרון שדווח</h3>
    {stat.mileage ? (
      <dl class="grid-data">
        <div class="datum">
          <dt>קריאות זמינות במדגם</dt>
          <dd>
            {stat.mileage.n} מתוך {stat.n} (
            {Math.round((stat.mileage.n / stat.n) * 100)}%)
          </dd>
        </div>
        <div class="datum">
          <dt>חציון</dt>
          <dd>{count.format(stat.mileage.median)} ק״מ</dd>
        </div>
        <div class="datum">
          <dt>טווח בין רבעונים</dt>
          <dd>
            {count.format(stat.mileage.p25)}–{count.format(stat.mileage.p75)}{' '}
            ק״מ
          </dd>
        </div>
      </dl>
    ) : (
      <p>אין במדגם מספיק קריאות זמינות להצגת התפלגות נסועה.</p>
    )}
    <p class="muted">
      החישוב מסנן קריאות אפס, ערכים מעל שני מיליון ק״מ וקריאות סותרות לאותה
      לוחית.
    </p>
    <p class="muted">
      <a href={resources.private_cars_1.url}>רישוי פעיל</a> ·{' '}
      <a href={resources.history_1.url}>נסועה מהיסטוריית הרכב</a>
    </p>
  </section>
)}
